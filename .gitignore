# =====================================================================
# 공개 저장소 유출 방지 (위험 R4·R10, 보안 리뷰 v0.1 6장)
# .gitignore는 `git add -f`로 우회된다. 같은 규칙을 scripts/scan.mjs가
# 커밋 전(.githooks/pre-commit)과 PR 검사(.github/workflows/scan.yml)에서 한 번 더 막는다.
# =====================================================================

# --- 실데이터: 카드·통장 내역, 내보내기, 캡처 ---------------------------
*.xlsx
*.xls
*.xlsm
*.xlsb
*.csv
*.tsv
*.ods
*.pdf
*.zip
*.7z
# 금융 내보내기 형식, 웹 페이지 저장본, 문서 형식
*.ofx
*.qif
*.mhtml
*.mht
*.docx
*.doc
*.hwp
*.hwpx
*.numbers
*.rtf
# 은행 HTML 위장 xls 등. 앱 진입점만 허용
*.html
*.htm
!/index.html
# 화면 캡처(실데이터가 찍힐 수 있음). 앱 아이콘만 허용
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
!/icons/*.png

# --- DB 덤프·백업 --------------------------------------------------------
# 저장소에 두는 SQL은 스키마와 마이그레이션만
*.sql
!/db/schema.sql
!/db/migrations/*.sql
*.sql.gz
*.dump
*.backup
*.bak
*.enc
*.db
*.sqlite
*.sqlite3
dumps/
exports/
backups/

# --- 샘플·개인 작업 폴더 (샘플은 저장소 밖에 둔다) -----------------------
samples/
private/
tmp/

# --- 비밀값 --------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
supabase/.temp/
supabase/.branches/

# --- 브라우저·네트워크 기록 (토큰이 들어 있음) ---------------------------
*.har
*.log

# --- 로컬 도구 -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
node_modules/
.vscode/
.idea/
